// Prisma schema. Run `pnpm db:generate` after editing.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) models — populated by @auth/prisma-adapter in feat/auth.
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  profile  PlayerProfile?
  matches  MatchPlayer[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------------------------------------------------------------------------
// Player profiles (feat/player-profiles)
// ---------------------------------------------------------------------------

enum Region {
  NA_EAST
  NA_WEST
  SA
  EU_WEST
  EU_EAST
  MENA
  AFRICA
  ASIA_EAST
  ASIA_SE
  OCEANIA
}

enum PlayStyle {
  CASUAL
  COMPETITIVE
  BOTH
}

/// Catalog of supported games. Seeded from `src/lib/games.ts`.
model Game {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  shortName String
  teamSize  Int      @default(5)
  roles     String[]
  ranks     String[] // ordered lowest -> highest
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  gameProfiles GameProfile[]
  matches      Match[]
}

model PlayerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  region      Region
  languages   String[]
  bio         String?
  timezone    String // IANA id, e.g. "Europe/Berlin"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  games        GameProfile[]
  availability AvailabilityWindow[]

  @@index([region])
}

model GameProfile {
  id        String    @id @default(cuid())
  profileId String
  profile   PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  roles     String[]
  rank      String
  playStyle PlayStyle @default(BOTH)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([profileId, gameId])
  @@index([gameId])
}

/// One recurring weekly window, in the profile's local timezone. Never crosses
/// midnight; a late-night slot is stored as two windows.
model AvailabilityWindow {
  id          String   @id @default(cuid())
  profileId   String
  profile     PlayerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from local midnight
  endMinute   Int
  createdAt   DateTime @default(now())

  @@index([profileId])
}

// ---------------------------------------------------------------------------
// Matches (feat/match-engine) — written by the matchmaking worker.
// ---------------------------------------------------------------------------

enum MatchState {
  FORMED
  READY
  LIVE
  COMPLETED
  CANCELLED
}

model Match {
  id         String     @id @default(cuid())
  gameId     String
  game       Game       @relation(fields: [gameId], references: [id])
  region     Region
  state      MatchState @default(FORMED)
  rankSpread Int // max - min rankIndex across the group, for telemetry
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  players MatchPlayer[]

  @@index([gameId, state])
}

model MatchPlayer {
  id       String @id @default(cuid())
  matchId  String
  match    Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  rank     String
  roles    String[]
  waitedMs Int

  @@unique([matchId, userId])
  @@index([userId])
}
