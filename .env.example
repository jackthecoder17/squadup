# Copy to `.env` and fill in. `.env` is gitignored.

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (matches docker-compose.yml) ----------------------------------
DATABASE_URL="postgresql://squadup:squadup@localhost:5432/squadup?schema=public"
# Only in production, and only if DATABASE_URL uses a connection pooler:
# the direct (non-pooled) URL, used for migrations and seeding.
# DIRECT_DATABASE_URL=""

# --- Redis (matches docker-compose.yml) -----------------------------------
REDIS_URL="redis://localhost:6379"

# --- Auth.js ---------------------------------------------------------------
# Generate with: pnpm dlx auth secret
AUTH_SECRET=""

# Discord OAuth app: https://discord.com/developers/applications
# Redirect URI: http://localhost:3000/api/auth/callback/discord
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""

# --- Production only -----------------------------------------------------
# Shared secret guarding /api/cron/tick (the serverless stand-in for the
# worker + simulator). Leave blank locally; set in the deploy. See DEPLOY.md.
CRON_SECRET=""
# Bot pool the cron tick maintains. Defaults to 30.
# SIM_BOTS="30"
